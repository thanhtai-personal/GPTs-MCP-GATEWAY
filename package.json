{
  "name": "mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "npm --prefix web run dev",
    "dev:server": "npm --prefix server run start:dev",
    "dev:gdrive": "npm --prefix gdrive-mcp run dev",
    "build:web": "npm --prefix web run build",
    "build:server": "npm --prefix server run build",
    "build:gdrive": "npm --prefix gdrive-mcp run build",
    "typecheck:web": "npm --prefix web run typecheck",
    "test:server": "npm --prefix server run test",
    "check:source": "node scripts/check-source.mjs",
    "check:schema": "node scripts/check-schema-contract.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:deps": "node scripts/check-dependency-policy.mjs",
    "check": "npm run check:source && npm run check:schema && npm run check:docs && npm run check:deps",
    "repair:server-deps": "node scripts/repair-server-dependencies.mjs",
    "audit:server": "npm --prefix server audit --audit-level=high",
    "audit:server:prod": "npm --prefix server audit --omit=dev --audit-level=high"
  },
  "license": "AGPL-3.0-or-later"
}
