+}
+a { color: inherit; text-decoration: none; }
+button, input { font: inherit; }
+button, .button {
+  border: 1px solid transparent;
+  border-radius: 10px;
+  background: var(--accent);
+  color: #07140f;
+  cursor: pointer;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  font-weight: 750;
+  padding: 0.72rem 1rem;
+}
+button:disabled { cursor: not-allowed; opacity: 0.55; }
+button.secondary, .button.secondary {
+  background: transparent;
+  color: #f5f7fb;
+  border-color: var(--border);
+}
+button.danger { background: transparent; color: var(--danger); border-color: rgba(255, 140, 140, .35); }
+input {
+  width: 100%;
+  margin-top: .45rem;
+  border-radius: 10px;
+  border: 1px solid var(--border);
+  background: #0e1320;
+  color: #fff;
+  padding: .8rem .9rem;
+}
+label { color: #dfe5f0; font-size: .92rem; display: block; }
+code {
+  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
+  overflow-wrap: anywhere;
+}
+.container { width: min(1120px, calc(100% - 2rem)); margin-inline: auto; }
+.site-header, .dashboard-top {
+  min-height: 74px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+}
+.brand { font-size: 1.05rem; font-weight: 850; letter-spacing: -.02em; }
+.row { display: flex; align-items: center; gap: .7rem; flex-wrap: wrap; }
+.spread { justify-content: space-between; }
+.hero {
+  min-height: 660px;
+  display: grid;
+  grid-template-columns: minmax(0, 1.15fr) minmax(300px, .85fr);
+  align-items: center;
+  gap: 4rem;
+  padding-block: 5rem;
+}
+.hero h1, .dashboard-intro h1 {
+  font-size: clamp(2.6rem, 6vw, 5.3rem);
+  line-height: .98;
+  letter-spacing: -.055em;
+  margin: .6rem 0 1.4rem;
+  max-width: 900px;
+}
+.dashboard-intro h1 { font-size: clamp(2rem, 5vw, 4rem); }
+.lead { color: #c0cadb; font-size: 1.18rem; line-height: 1.75; max-width: 760px; }
+.lead.small { font-size: 1rem; }
+.eyebrow { color: var(--accent); font-size: .76rem; letter-spacing: .16em; font-weight: 850; }
+.terminal-card, .card {
+  border: 1px solid var(--border);
+  background: var(--panel);
+  border-radius: 18px;
+  box-shadow: 0 22px 80px rgba(0, 0, 0, .24);
+}
+.terminal-card { padding: 2rem; }
+.terminal-card code { white-space: pre-wrap; line-height: 2; color: #c9d4e8; }
+.section { padding-block: 5rem; }
+.section h2 { font-size: clamp(2rem, 4vw, 3.4rem); letter-spacing: -.04em; max-width: 780px; }
+.grid { display: grid; gap: 1rem; }
+.grid.three { grid-template-columns: repeat(3, 1fr); }
+.card { padding: 1.35rem; }
+.card h2, .card h3 { margin-top: .35rem; }
+.card p { line-height: 1.65; }
+.split { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: end; }
+.footer {
+  min-height: 150px;
+  display: flex;
+  justify-content: space-between;
+  gap: 1rem;
+  align-items: center;
+  color: var(--muted);
+  border-top: 1px solid var(--border);
+}
+.dashboard { padding-bottom: 5rem; }
+.dashboard.narrow { max-width: 720px; }
+.dashboard-intro { padding: 3rem 0 2rem; }
+.dashboard-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
+.dashboard-grid > :last-child { grid-column: 1 / -1; }
+.panel-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
+.status {
+  border: 1px solid var(--border);
+  color: var(--muted);
+  border-radius: 999px;
+  padding: .35rem .65rem;
+  font-size: .78rem;
+}
+.status.good { color: var(--accent); border-color: rgba(119, 230, 189, .35); }
+.muted { color: var(--muted); }
+.subcard, .secret-box {
+  margin-top: 1rem;
+  padding: 1rem;
+  background: var(--panel-2);
+  border: 1px solid var(--border);
+  border-radius: 12px;
+}
+.secret-box { display: grid; gap: .8rem; }
+.secret-box code { color: #ffe09d; }
+.stack { display: grid; gap: .7rem; margin-top: .8rem; }
+.token-row { display: flex; gap: .8rem; justify-content: space-between; align-items: center; }
+.file-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem; margin: 1rem 0; }
+.file-list code { padding: .7rem; background: #0e1320; border-radius: 8px; border: 1px solid var(--border); }
+.notice { padding: .75rem .9rem; background: var(--panel-2); border-radius: 9px; }
+.notice.success { color: var(--accent); }
+.notice.error { color: var(--danger); }
+.auth-card { display: grid; gap: 1rem; margin-top: 4rem; }
+.language-switcher { display: flex; gap: .3rem; }
+.language-switcher button { padding: .45rem .55rem; background: transparent; color: var(--muted); }
+.language-switcher button.active { color: #0a0d14; background: var(--accent); }
+.hero-actions { margin-top: 2rem; }
+
+@media (max-width: 780px) {
+  .hero, .split, .dashboard-grid, .grid.three { grid-template-columns: 1fr; }
+  .hero { gap: 2rem; padding-block: 3.5rem; }
+  .dashboard-grid > :last-child { grid-column: auto; }
+  .footer { align-items: flex-start; flex-direction: column; justify-content: center; }
+  .token-row { align-items: flex-start; flex-direction: column; }
+}
diff --git a/web/start.mjs b/web/start.mjs
new file mode 100644
index 0000000..15e81fe
--- /dev/null
+++ b/web/start.mjs
@@ -0,0 +1,21 @@
+import path from "node:path";
+import { spawn } from "node:child_process";
+import { fileURLToPath } from "node:url";
+
+const webRoot = path.dirname(fileURLToPath(import.meta.url));
+const viteCli = path.join(webRoot, "node_modules", "vite", "bin", "vite.js");
+
+const child = spawn(
+  process.execPath,
+  [viteCli, "dev", "--host", "127.0.0.1", ...process.argv.slice(2)],
+  {
+    cwd: webRoot,
+    env: process.env,
+    stdio: "inherit",
+    shell: false,
+  },
+);
+
+child.on("exit", (code) => {
+  process.exitCode = code ?? 0;
+});
