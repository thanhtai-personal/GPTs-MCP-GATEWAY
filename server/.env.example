NODE_ENV=development
PORT=5657
WEB_BASE_URL=http://127.0.0.1:5656
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5656

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AES-256-GCM key used to encrypt saved MCP provider API keys.
# Generate once per environment with: openssl rand -base64 32
# Keep it stable: changing/losing it makes existing encrypted credentials undecryptable.
# Base64-encoded exactly 32 random bytes.
MCP_CREDENTIAL_ENCRYPTION_KEY=

GATEWAY_PUBLIC_BASE_URL=http://127.0.0.1:5657
GATEWAY_RATE_LIMIT_PER_MINUTE=60
MCP_UPSTREAM_TIMEOUT_MS=30000
# Custom GPT Actions have a finite response body budget. Gateway wraps and
# persists oversized responses, then exposes continuation chunks.
GPT_ACTION_RESPONSE_MAX_CHARS=80000
GPT_RESPONSE_TRANSFER_TTL_SECONDS=600
GPT_RESPONSE_MAX_STORED_CHARS=5000000

# OAuth MCP providers.
MCP_OAUTH_STATE_TTL_SECONDS=600

# Lovable currently restricts OAuth to supported MCP clients. The shared public
# client ID documented for editor clients is not registered for this Gateway's
# hosted callback URL and must not be reused here. Leave these empty until
# Lovable explicitly allows/registers a client for this Gateway.
LOVABLE_MCP_OAUTH_CLIENT_ID=
LOVABLE_MCP_OAUTH_CLIENT_SECRET=

# Figma Remote MCP currently admits only Figma-approved MCP clients.
# There is no self-service MCP client registration. A normal Figma REST OAuth
# app client ID/secret does NOT grant the required mcp:connect scope.
# While review is pending, leave both values empty; Gateway exposes Figma as
# pending_review and disables Connect. Set CLIENT_ID only after Figma approves
# this Gateway and tells you which MCP OAuth client ID to use. Set CLIENT_SECRET
# only if Figma explicitly issues one; public MCP clients may not have a secret.
FIGMA_MCP_OAUTH_CLIENT_ID=
FIGMA_MCP_OAUTH_CLIENT_SECRET=


# GitHub Remote MCP.
# Each hosted MCP client must use a GitHub OAuth App or GitHub App registered
# for this Gateway callback:
#   <GATEWAY_PUBLIC_BASE_URL>/api/v1/mcp-connections/github/oauth/callback
# GitHub's token exchange requires the app client secret.
GITHUB_MCP_OAUTH_CLIENT_ID=
GITHUB_MCP_OAUTH_CLIENT_SECRET=

# Notion Remote MCP uses OAuth + PKCE + Dynamic Client Registration.
# No static Notion client ID/secret is required.


# Google Workspace remote MCP (Docs + Sheets).
# These MUST match the Google OAuth Web client configured for the Google
# provider in Supabase Auth so provider refresh tokens can be refreshed here.
GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=
GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=
