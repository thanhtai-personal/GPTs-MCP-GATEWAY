# OAuth client from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Run `npm run token` to get this value
GOOGLE_REFRESH_TOKEN=1//xxxxxxxx

# Secret that protects your MCP endpoint. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MCP_API_KEY=change-me
